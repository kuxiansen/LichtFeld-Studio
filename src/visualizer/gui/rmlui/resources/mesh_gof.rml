<rml>
  <head>
    <link type="text/template" href="floating_window.rml" />
    <link type="text/rcss" href="rendering.rcss" />
    <link type="text/rcss" href="export_panel.rcss" />
  </head>
  <body template="floating-window" data-model="mesh_gof">
    <div data-if="gof_source == ''" class="text-muted">@tr:rendering_panel.simplify_select_source</div>
    <div data-if="gof_source != ''"><span>@tr:rendering_panel.simplify_source</span>: {{gof_source}}</div>
    <div class="text-muted">@tr:mesh_gof.hint</div>
    <div id="gof-fields"></div>
    <div data-if="gof_active">
      <progress max="1" data-attr-value="gof_progress" />
      <span>{{gof_status}}</span>
    </div>
    <div data-if="gof_error != ''" class="text-error"><span>@tr:status.error</span>: {{gof_error}}</div>
    <div class="ep-buttons">
      <button class="btn btn--primary" data-attrif-disabled="gof_source == '' || gof_active" data-event-click="gof_run">@tr:new_project.create</button>
      <button data-if="!gof_active" class="btn btn--secondary ep-action-btn" data-event-click="gof_close">@tr:common.cancel</button>
      <button data-if="gof_active" class="btn btn--secondary ep-action-btn" data-event-click="gof_cancel">@tr:common.cancel</button>
    </div>
  </body>
</rml>
